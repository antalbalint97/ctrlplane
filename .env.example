# Public analytics configuration (GTM IDs are public, not secrets)
NEXT_PUBLIC_GTM_ID=GTM-P97RB9PD
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_BRAND_ID=ctrlplane
NEXT_PUBLIC_SITE_URL=https://ctrplane.com

# Server-only storage. Reuse the existing Atlas URI; select CtrlPlane's database below.
MONGODB_URI=
MONGODB_DB_NAME=ctrlplane

# Optional contact sync; both values are required to enable it.
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# Optional welcome email for NEW signups, after successful contact sync.
# A plain sender address on a domain verified in Resend; blank disables welcome sends.
# Uses RESEND_API_KEY above, which must also have sending permission.
RESEND_FROM_EMAIL=
