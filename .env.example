# Public analytics configuration (GTM IDs are public, not secrets)
NEXT_PUBLIC_GTM_ID=GTM-P97RB9PD
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_BRAND_ID=ctrlplane
NEXT_PUBLIC_SITE_URL=https://ctrplane.com

# Server-only storage. Reuse the existing Atlas URI; select CtrlPlane's database below.
MONGODB_URI=
MONGODB_DB_NAME=ctrlplane

# Optional contact sync; both values are required to enable it. No email is sent.
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# Verified public controller details, rendered server-side. Required before launch.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
